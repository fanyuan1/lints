{
  "name": "lints",
  "version": "0.4.1",
  "description": "Shared lint rules that steer coding agents: ESLint plugin, plus checks for other languages.",
  "type": "module",
  "main": "./eslint/index.js",
  "exports": {
    ".": "./eslint/index.js"
  },
  "files": [
    "eslint/"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "node --test test/ && python3 -m unittest discover -s test -p '*_test.py'",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0"
  },
  "peerDependencies": {
    "eslint": ">=9.24.0"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
