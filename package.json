{
  "name": "lints",
  "version": "0.5.0",
  "description": "Shared lint rules that steer coding agents: ESLint plugin, plus checks for other languages.",
  "type": "module",
  "main": "./eslint/index.js",
  "exports": {
    ".": "./eslint/index.js",
    "./tsconfig.json": "./tsconfig.base.json"
  },
  "files": [
    "eslint/",
    "bin/",
    "tsconfig.base.json"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "node --test test/ && python3 -m unittest discover -s test -p '*_test.py'",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.2"
  },
  "peerDependencies": {
    "eslint": ">=9.24.0"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "bin": {
    "lints-baseline": "./bin/lints-baseline.js"
  }
}
